# Environment variables for the bookings site. Set them on the Vercel project, not in this file.
# Local development needs none of them: `npm run dev` supplies its own.

# Added automatically when the Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# At least 16 random characters. Signs the sign-in cookies; changing it signs everyone out.
SESSION_SECRET=

# The recovery password. Opens any admin login if a password is forgotten.
OWNER_PASSWORD=

# The daily reminder job. Vercel sends it as "Authorization: Bearer <value>"; at least 16 random characters.
CRON_SECRET=

# Optional: email the studio when a booking comes in and 48 hours before each appointment (https://resend.com).
RESEND_API_KEY=
# Optional: comma separated recipients. Defaults to the studio email in Settings.
NOTIFY_EMAIL=
# Optional: the sender. Defaults to "GLAM BY OYIN <onboarding@resend.dev>".
NOTIFY_FROM=
