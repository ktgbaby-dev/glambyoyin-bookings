{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "regions": [
    "lhr1"
  ],
  "functions": {
    "api/cron/*.js": { "maxDuration": 60 },
    "api/account.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/reminders", "schedule": "0 6 * * *" }
  ]
}
